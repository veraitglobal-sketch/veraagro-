# ============================================================
# Bio Vera Blockchain - Environment Variables
# Kopiraj u .env i popuni vrednosti
# NIKAD ne commituj .env u git!
# ============================================================

# ─── Blockchain Network ──────────────────────────────────────
# "polygon" za produkciju, "polygonMumbai" za testiranje
BLOCKCHAIN_NETWORK=polygonMumbai

# ─── RPC URLs ─────────────────────────────────────────────────
# Besplatno: https://rpc-mumbai.maticvigil.com (testnet)
# Preporučeno za produkciju: Alchemy ili Infura
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# ─── Wallet ───────────────────────────────────────────────────
# Private key Bio Vera backend wallet-a koji šalje transakcije
# VAŽNO: Ovaj wallet mora imati MATIC za gas fees!
# Na testnet-u: besplatni MATIC sa https://faucet.polygon.technology
DEPLOYER_PRIVATE_KEY=your_private_key_here
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here

# ─── Contract ─────────────────────────────────────────────────
# Popuni nakon deploy-a (hardhat run scripts/deploy.js)
CONTRACT_ADDRESS=0x...

# ─── Polygonscan (opciono, za verifikaciju koda) ──────────────
# Registruj se na https://polygonscan.com/register
POLYGONSCAN_API_KEY=your_api_key_here

# ─── Gas reporting (opciono, za development) ─────────────────
REPORT_GAS=false
