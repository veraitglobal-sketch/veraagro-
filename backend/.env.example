# Database — pick one setup (uncomment / adjust) --------------------------------

# (A) Supabase — Dashboard → Settings → Database → URI
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"

# (B) Railway from your Mac (`npx prisma`, local Nest): MUST use public networking.
#     Do NOT use postgres.railway.internal here — P1001 from laptop.
#   • Postgres → Settings → Networking → Public hostname:port (or TCP proxy host:port)
#   • Password: Postgres service → Variables (POSTGRES_PASSWORD)
#   • DB name is often `railway`; user often `postgres`
#   • Add: ?sslmode=require
#   • Deployed API on Railway can still use the private `...@postgres.railway.internal:...` in its own vars.
#
# Copy this line into `.env` and replace xxxx + password:
DATABASE_URL="postgresql://postgres:YOUR_RAILWAY_PASSWORD@postgres-production-xxxx.up.railway.app:5432/railway?sslmode=require"

# Escrow split percentages (must sum to ~100). See PAYMENTS_SERVICE / README.
# PAYMENT_FARMER_PERCENTAGE=70
# PAYMENT_DRIVER_PERCENTAGE=20
# PAYMENT_PLATFORM_FEE=10
#
# Treasury: UUID of a dedicated `users` row whose wallet receives the platform share on escrow release.
# If unset, farmer/driver credits still run; platform fee is only logged (not wallet-credited).
# PLATFORM_WALLET_USER_ID=

# JWT Secret (generate a random string for production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Bio Vera seed label HMAC secret — set in Railway BEFORE the first labels are printed.
# NEVER change after labels exist in the field; tampered check digits depend on this value.
# Falls back to JWT_SECRET if unset (dev only).
# SEED_LABEL_SECRET="generate-a-long-random-string-never-rotate-after-print"

# Application
PORT=3000
NODE_ENV=development

# Public web (Next.js) — REQUIRED for correct QR code targets (farmer profile + /verify/batch links).
# Must be the real origin users open in the browser, e.g. https://app.biovera.app  (no trailing slash)
# FRONTEND_URL=https://app.biovera.app

# Resend (email) - for contact form, welcome emails
# Get API key: https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
# New order / pre-order notifications (falls back to ADMIN_EMAIL, then info@biovera.app)
# ORDERS_NOTIFY_EMAIL=info@biovera.app
# ADMIN_EMAIL=info@biovera.app
# Pre-order / Vera Trade: stable estate row for FK (auto-created; override only if you know why)
# PRE_ORDER_ESTATE_ID=biov-preorder-system

# Optional: Supabase API Keys (if needed for direct API calls)
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Blockchain (Polygon) - optional; if not set, blockchain API returns 503 and passport shows "Not configured"
# For Polygon Amoy testnet:
# POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_NETWORK=polygonAmoy
# For Polygon mainnet:
# POLYGON_RPC_URL=https://polygon-rpc.com
# BLOCKCHAIN_NETWORK=polygon
# BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key   # must be authorized on contract (deployer is auto-authorized)
# CONTRACT_ADDRESS=0x...   # from: cd blockchain/files && npx hardhat run deploy.js --network polygonAmoy

# Missions: when unset/false, new transport requests stay PENDING until an admin assigns a driver (default).
# Set to true only if you want the old behaviour (auto-pick nearest logistics partner with a cold truck).
# MISSIONS_AUTO_ASSIGN_LOGISTICS_PARTNER=true

# When true, a batch with a parcel must have a CONFIRMED harvest plan (admin: /admin/harvest-plans) before
# the grower can create transport. When false, transport is still allowed; harvest link is set when a matching plan exists.
# MISSIONS_REQUIRE_CONFIRMED_HARVEST_PLAN=true

# Transport pre-approval (default on): new grower transport missions start as AWAITING_APPROVAL until admin approves
# in /admin/grower-control. Set to true only to skip (old behaviour: missions go straight to PENDING).
# MISSIONS_SKIP_ADMIN_APPROVAL=true

# NEVER in production: when 1 or true, POST /field-entries skips GPS boundary checks (local QA only).
# FIELD_ENTRY_RELAX_GPS=1

# Field entry GPS: meters from parcel/estate polygon edge still counted “inside” (default 80). Client may send location.accuracy to widen further.
# GPS_BOUNDARY_TOLERANCE_METERS=80

# Active planting plans: growers must submit a growth journal entry (photo + GPS + notes + stage) at least every N days (default 18).
# PLANTING_PROGRESS_INTERVAL_DAYS=18
# Minimum note length for planting-related growth logs (default 15).
# PLANTING_PROGRESS_NOTES_MIN_LEN=15

# Firebase Cloud Messaging (mobile push) — service account from Firebase Console → Project settings → Service accounts
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
