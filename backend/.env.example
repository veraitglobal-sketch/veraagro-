# Bio Vera backend — copy to `.env` for local dev. Never commit real secrets.
# Railway (production): set the same names in Dashboard → Service → Variables.

# --- Required ---

# PostgreSQL connection (Railway auto-generates when PostgreSQL is attached)
DATABASE_URL=postgresql://user:password@localhost:5432/biovera_db

# JWT signing (auth tokens). Min 32 chars in production.
JWT_SECRET=change-me-local-dev-min-32-characters

# --- Seed production (required before first printed label) ---

# HMAC secret for seed bag label serials. Falls back to JWT_SECRET if unset.
# MUST stay stable forever once physical labels are printed — changing it invalidates scans.
# Read in: backend/src/seed-production/seed-serial.ts
SEED_LABEL_SECRET=change-me-before-first-label-print-min-32-chars

# Public HTTPS URL of this API (certificate PDF links, stored document URLs).
# Read in: backend/src/stored-documents/stored-documents.service.ts
API_PUBLIC_URL=https://your-backend.up.railway.app
# Alias accepted by stored-documents service:
# BACKEND_URL=https://your-backend.up.railway.app

# --- Application ---

PORT=3000
NODE_ENV=development

# CORS + links in emails (QR verify, farmer profile, producer invite).
# Read in: backend/src/main.ts, email.service.ts, qr.service.ts, seed-production.service.ts
FRONTEND_URL=http://localhost:3001
# Optional alias for producer portal invite links (preferred over FRONTEND_URL when set):
# WEB_PUBLIC_URL=https://biovera.app

# Railway sets this automatically when a public domain is assigned:
# RAILWAY_PUBLIC_DOMAIN=your-backend.up.railway.app

# --- Email (Resend / SMTP) ---

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Until biovera.app is Verified in Resend → Domains:
RESEND_SANDBOX=1
EMAIL_FROM=onboarding@resend.dev
# After domain Verified:
# RESEND_SANDBOX=0
# EMAIL_FROM=info@biovera.app
ADMIN_EMAIL=info@biovera.app
# ORDERS_NOTIFY_EMAIL=orders@biovera.app

# --- Optional integrations ---

# Vercel Blob — quality photos, B2B uploads, batch attachments
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Firebase Cloud Messaging — mobile push
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenAI — AI assistant module
# OPENAI_API_KEY=sk-...

# OpenWeather — logistics optimizer weather
# OPENWEATHER_API_KEY=

# Handover receiving codes (falls back to JWT_SECRET)
# HANDOVER_CODE_SECRET=

# --- Feature flags / tuning ---

# ALLOW_START_WITHOUT_MIGRATE=true
# LOG_LEVEL=debug
# GPS_BOUNDARY_TOLERANCE_METERS=50
# FIELD_ENTRY_RELAX_GPS=false
# PLANTING_PROGRESS_INTERVAL_DAYS=7
# PLANTING_PROGRESS_NOTES_MIN_LEN=10
# MISSIONS_AUTO_ASSIGN_LOGISTICS_PARTNER=false
# MISSIONS_SKIP_ADMIN_APPROVAL=false
# MISSIONS_REQUIRE_CONFIRMED_HARVEST_PLAN=false
# VERA_PLATFORM_ESTATE_ID=biov-vera-platform
# PRE_ORDER_ESTATE_ID=biov-preorder-system
# BIOVERA_FRESH_HERO_URL=
