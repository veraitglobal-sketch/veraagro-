  discount_quota_usage discount_quota_usage[]
  invoices             invoices?
  order_items          order_items[]
  users                users                  @relation(fields: [buyerId], references: [id])
  estates              estates                @relation("OrderSellerEstate", fields: [estateId], references: [id])
  fulfilling_estate    estates?               @relation("OrderFulfillingEstate", fields: [fulfillingEstateId], references: [id])
  parcels              parcels?               @relation(fields: [parcelId], references: [id])
  payments             payments?
  ratings              ratings[]
  missions             missions[]
  packed_batch         batches?               @relation("OrderPackedBatch", fields: [packedBatchId], references: [id])

  @@index([buyerId])
