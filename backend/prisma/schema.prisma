generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id                String      @id
  performedByUserId String?
  performedByRole   UserRole?
  action            AuditAction
  entityType        String
  entityId          String?
  changes           Json?
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([performedByUserId])
}

model audit_trails {
  id                String         @id
  eventType         AuditEventType
  entityType        String
  entityId          String
  batchId           String?
  performedByUserId String?
  oldValue          Json?
  newValue          Json
  changeReason      String?
  location          Json?
  temperature       Float?
  temperatureUnit   String?
  deviceId          String?
  deviceModel       String?
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime       @default(now())
  isCompliant       Boolean        @default(true)
  batches           batches?       @relation(fields: [batchId], references: [id])
  users             users?         @relation(fields: [performedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([performedByUserId])
  @@index([timestamp])
}

model batches {
  id                                         String                 @id
  batchId                                    String                 @unique
  estateId                                   String
  parcelId                                   String?
  harvestAnnouncementId                      String?
  harvest_announcement                       harvest_announcements? @relation(fields: [harvestAnnouncementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  harvestedByUserId                          String?
  currentHubId                               String?
  transportedByDriverId                      String?
  productName                                String
  quantity                                   Float
  unit                                       String
  harvestDate                                DateTime
  status                                     BatchStatus            @default(PACKED)
  qualityIssues                              Json?
  inventoryId                                String?
  locationHistory                            Json
  blockchainTxHash                           String?
  blockchainRegisteredAt                     DateTime?
  createdAt                                  DateTime               @default(now())
  updatedAt                                  DateTime
  audit_trails                               audit_trails[]
  hubs                                       hubs?                  @relation(fields: [currentHubId], references: [id])
  estates                                    estates                @relation(fields: [estateId], references: [id])
  users_batches_harvestedByUserIdTousers     users?                 @relation("batches_harvestedByUserIdTousers", fields: [harvestedByUserId], references: [id])
  inventory                                  inventory?             @relation(fields: [inventoryId], references: [id])
  parcels                                    parcels?               @relation(fields: [parcelId], references: [id])
  users_batches_transportedByDriverIdTousers users?                 @relation("batches_transportedByDriverIdTousers", fields: [transportedByDriverId], references: [id])
  compliance_photos                          compliance_photos[]
  distributor_arrivals                       distributor_arrivals[]
  freshness_trackers                         freshness_trackers?
  missions                                   missions[]
  order_items                                order_items[]
  quality_entries                            quality_entries?
  temperature_logs                           temperature_logs[]
  package_badges                             package_badges[]
  orders_packed_as                           orders[]               @relation("OrderPackedBatch")

  @@index([harvestAnnouncementId])
  @@index([batchId])
  @@index([currentHubId])
  @@index([estateId])
  @@index([status])
}

model bio_vera_standards {
  id                       String   @id
  requiredTemperatureMin   Float    @default(2.0)
  requiredTemperatureMax   Float    @default(8.0)
  requiredPackagingType    String   @default("BIO_VERA_CRATE")
  requiredFilmType         String   @default("BIO_VERA_FILM")
  requiresCompliancePhotos Boolean  @default(true)
  requiredPhotoTypes       String[] @default(["PUNNETS", "LABELING", "PALLETIZATION"])
  qualityPremiumAmount     Float    @default(0.10)
  crateCostPerUnit         Float    @default(0.50)
  labelCostPerUnit         Float    @default(0.10)
  filmCostPerMeter         Float    @default(0.05)
  isActive                 Boolean  @default(true)
  updatedByUserId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  users                    users?   @relation(fields: [updatedByUserId], references: [id])

  @@index([isActive])
}

model bio_white_list {
  id           String   @id
  barcode      String   @unique
  productName  String
  manufacturer String
  /// FERTILIZER | PESTICIDE | SEED | OTHER — grower + admin; filters in app
  materialType String   @default("OTHER")
  description  String?
  phiDays      Int? // Pre-Harvest Interval (days) - blocks harvest until elapsed
  mrlLimit     Float? // Max residue limit (optional)
  isActive     Boolean  @default(true)
  addedBy      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([barcode])
  @@index([isActive])
  @@index([materialType])
}

model kyc_documents {
  id              String    @id @default(uuid())
  userId          String
  docType         String // 'ID_FRONT' | 'ID_BACK' | 'PASSPORT' | 'LAND_REGISTRY' | 'LEASE'
  fileUrl         String
  verifiedAt      DateTime?
  verifiedBy      String?
  status          String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  rejectionReason String?
  createdAt       DateTime  @default(now())
  users           users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model treatment_logs {
  id              String   @id @default(uuid())
  parcelId        String
  userId          String
  productId       String // bio_white_list.id
  productName     String
  dosage          String // e.g. "2 L/ha"
  waterVolume     Float? // litres
  reason          String? // e.g. "grey mould protection"
  appliedAt       DateTime
  gpsLatitude     Float
  gpsLongitude    Float
  gpsAccuracy     Float?
  deviceId        String?
  deviceTimestamp DateTime
  needsAudit      Boolean  @default(false) // true if submitted offline >24h after apply
  createdAt       DateTime @default(now())
  parcels         parcels  @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  users           users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@index([userId])
  @@index([appliedAt])
}

model border_wait_times {
  id                String   @id
  missionId         String
  borderName        String?
  borderArrivalTime DateTime
  borderExitTime    DateTime
  waitTimeMinutes   Int
  notes             String?
  recordedByUserId  String
  createdAt         DateTime @default(now())
  missions          missions @relation(fields: [missionId], references: [id])
  users             users    @relation(fields: [recordedByUserId], references: [id])

  @@index([borderArrivalTime])
  @@index([missionId])
  @@index([recordedByUserId])
}

model compliance_logs {
  id                     String    @id
  farmerId               String
  estateId               String
  parcelId               String?
  entryType              String
  scannedBarcode         String
  barcodeType            String
  isCompliant            Boolean
  complianceStatus       String
  blockedReason          String?
  gpsLatitude            Float
  gpsLongitude           Float
  gpsAccuracy            Float?
  isWithinFarm           Boolean
  photos                 String[]
  deviceFingerprint      String
  deviceId               String?
  deviceTimestamp        DateTime
  synced                 Boolean   @default(false)
  syncedAt               DateTime?
  offlineId              String?
  relatedSeedInventoryId String?
  relatedBatchId         String?
  createdAt              DateTime  @default(now())
  networkTimestamp       DateTime  @default(now())
  estates                estates   @relation(fields: [estateId], references: [id])
  users                  users     @relation(fields: [farmerId], references: [id])
  parcels                parcels?  @relation(fields: [parcelId], references: [id])

  @@index([complianceStatus])
  @@index([createdAt])
  @@index([entryType])
  @@index([estateId])
  @@index([farmerId])
  @@index([isCompliant])
  @@index([parcelId])
  @@index([scannedBarcode])
  @@index([synced])
}

model compliance_photos {
  id         String    @id
  batchId    String
  photoType  String
  photoUrl   String
  photoHash  String
  verifiedBy String?
  verifiedAt DateTime?
  isVerified Boolean   @default(false)
  uploadedAt DateTime  @default(now())
  uploadedBy String
  batches    batches   @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([isVerified])
  @@index([photoType])
}

model deliveries {
  returnCase        delivery_returns?
  refund            delivery_refunds?
  missionId         String? @unique
  mission           missions? @relation(fields: [missionId], references: [id], onDelete: Restrict)
  id                String             @id
  deliveryNumber    String             @unique
  orderId           String             @unique
  buyer_delivery_issues buyer_delivery_issues[]
  driverId          String
  pickupLocation    Json
  pickupAddress     String
  deliveryLocation  Json
  deliveryAddress   String
  status            DeliveryStatus     @default(PENDING)
  deliveryQRCode    String             @unique
  qrScannedAt       DateTime?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  inTransitAt       DateTime?
  deliveredAt       DateTime?
  /// Buyer confirmation of physical takeover (starts 24h issue window); distinct from dock `deliveredAt`.
  buyerPickupConfirmedAt DateTime?
  confirmedAt       DateTime?
  pickupSignature   String?
  deliverySignature String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  users             users              @relation(fields: [driverId], references: [id])
  orders            orders             @relation(fields: [orderId], references: [id])
  digital_handovers digital_handovers? @relation("DigitalHandovers")
  invoices          invoices?
  waybills          waybills?

  @@index([deliveryQRCode])
  @@index([buyerPickupConfirmedAt])
  @@index([driverId])
  @@index([orderId])
  @@index([status])
}

model buyer_delivery_issues {
  returnCase        delivery_returns?
  status      String @default("PENDING")
  resolution  String?
  outcome     String?
  resolvedBy  String?
  resolvedAt  DateTime?
  revision    Int @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
  id          String      @id @default(uuid())
  deliveryId String
  buyerId    String
  description String
  photoUrls Json
  createdAt DateTime    @default(now())
  deliveries deliveries @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  users      users       @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([buyerId])
  @@index([createdAt])
}

model digital_passports {
  id                String         @id
  estateId          String
  parcelIds         String[]
  exportData        Json
  passportHash      String         @unique
  signature         String?
  status            PassportStatus @default(DRAFT)
  generatedByUserId String?
  generatedAt       DateTime       @default(now())
  exportedAt        DateTime?
  estates           estates        @relation(fields: [estateId], references: [id])

  @@index([estateId])
  @@index([passportHash])
}

model discount_quota_usage {
  id                 String   @id
  farmerId           String
  orderId            String?
  quantityUsed       Float
  discountRate       Float
  discountAmount     Float
  maxQuotaPerHectare Float    @default(200)
  estateArea         Float
  createdAt          DateTime @default(now())
  users              users    @relation(fields: [farmerId], references: [id])
  orders             orders?  @relation(fields: [orderId], references: [id])

  @@index([createdAt])
  @@index([farmerId])
  @@index([orderId])
}

model distributor_arrivals {
  id                   String   @id
  batchId              String
  hubName              String
  arrivalTime          DateTime @default(now())
  temperatureAtArrival Float
  visualState          String
  notes                String?
  photos               String[]
  recordedByUserId     String
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  batches              batches  @relation(fields: [batchId], references: [id])
  users                users    @relation(fields: [recordedByUserId], references: [id])

  @@index([arrivalTime])
  @@index([batchId])
  @@index([recordedByUserId])
}

model estates {
  id                     String              @id
  name                   String
  ownerId                String
  estateQrCode           String?             @unique
  polygonCoordinates     Json
  calculatedArea         Float
  verifiedArea           Float?
  status                 EstateStatus        @default(PENDING_SETUP)
  certificationStartDate DateTime?
  daysRemaining          Int?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime
  batches                batches[]
  compliance_logs        compliance_logs[]
  digital_passports      digital_passports[]
  users                  users               @relation(fields: [ownerId], references: [id])
  growth_logs            growth_logs[]
  inventory              inventory[]
  line_orders            orders[]            @relation("OrderSellerEstate")
  fulfilling_orders      orders[]            @relation("OrderFulfillingEstate")
  catalog_products       catalog_products[]
  parcels                parcels[]
  security_alerts        security_alerts[]

  @@index([ownerId])
  @@index([status])
}

/// Admin-managed marketplace product: planned season quantity sold in fixed packs.
model catalog_products {
  id                String                 @id @default(uuid())
  name              String
  category          String?
  description       String?
  imageUrl          String?
  estateId          String?
  sourcePlantingId  String?
  plannedQuantityKg Float
  availableFrom     DateTime?
  availableUntil    DateTime?
  status            CatalogProductStatus   @default(DRAFT)
  createdBy         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  estate            estates?               @relation(fields: [estateId], references: [id])
  source_planting   harvest_announcements? @relation("CatalogFromPlanting", fields: [sourcePlantingId], references: [id])
  packOptions       catalog_pack_options[]
  stockMovements    catalog_stock_movements[]
  orders            orders[]

  @@index([status])
  @@index([estateId])
  @@index([sourcePlantingId])
}

model catalog_stock_movements {
  id         String                   @id @default(uuid())
  productId  String
  type       CatalogStockMovementType
  quantityKg Float
  orderId    String?
  batchId    String?
  reason     String?
  actorId    String?
  createdAt  DateTime                 @default(now())
  product    catalog_products         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([productId, createdAt])
}

/// A sellable packaging of a catalogue product (500 g, 5 kg, 10 kg …) with its own price.
model catalog_pack_options {
  id           String           @id @default(uuid())
  productId    String
  label        String
  packSizeKg   Float
  pricePerPack Float
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      catalog_products @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders       orders[]

  @@index([productId])
}

model farmer_material_balances {
  id               String   @id
  userId           String   @unique
  crateBalance     Int      @default(0)
  labelRollBalance Int      @default(0)
  filmMeterBalance Float    @default(0)
  totalPurchased   Json
  lastUpdated      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  users            users    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model freshness_trackers {
  id                      String    @id
  batchId                 String    @unique
  cropType                String
  timestampHarvested      DateTime
  shelfLifeHours          Int
  remainingShelfLifeHours Float
  expiresAt               DateTime
  isExpired               Boolean   @default(false)
  alertSentAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  batches                 batches   @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([expiresAt])
  @@index([isExpired])
}

model growth_logs {
  id                        String                 @id
  userId                    String
  estateId                  String
  parcelId                  String?
  imageUrl                  String
  imageHash                 String
  gpsLatitude               Float
  gpsLongitude              Float
  gpsAccuracy               Float?
  deviceId                  String
  deviceModel               String?
  networkTimestamp          DateTime
  deviceTimestamp           DateTime
  timeOffset                Int?
  notes                     String?
  growthStage               String?
  /// Scanned / typed material code (setva, đubrivo, prskanje)
  materialBarcode           String?
  /// SEED | FERTILIZER | PESTICIDE
  materialKind              String?
  dataHash                  String                 @unique
  previousLogHash           String?
  /// APPROVED (visible) | REJECTED (hidden from grower passport views)
  moderationStatus          String                 @default("APPROVED")
  rejectionReason           String?
  moderatedAt               DateTime?
  moderatedByUserId         String?
  labResultUrl              String?
  labResultHash             String?
  labTestDate               DateTime?
  createdAt                 DateTime               @default(now())
  /// Which crop plan (sadnja/berba) this photo belongs to; required for new app entries
  harvestAnnouncementId     String?
  estates                   estates                @relation(fields: [estateId], references: [id])
  harvest_announcements     harvest_announcements? @relation(fields: [harvestAnnouncementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parcels                   parcels?               @relation(fields: [parcelId], references: [id])
  users                     users                  @relation(fields: [userId], references: [id])

  @@index([dataHash])
  @@index([estateId])
  @@index([networkTimestamp])
  @@index([parcelId])
  @@index([userId])
  @@index([harvestAnnouncementId])
  @@index([materialBarcode])
}

model hubs {
  id        String      @id
  name      String
  location  Json
  address   String
  city      String
  status    HubStatus   @default(ACTIVE)
  managerId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime
  batches   batches[]
  users     users?      @relation(fields: [managerId], references: [id])
  inventory inventory[]

  @@index([city])
  @@index([status, city])
  @@index([status])
}

model inventory {
  orderReservations order_stock_reservations[]
  returnDispositionCounts return_dispositions[]
  id                    String          @id
  hubId                 String
  estateId              String
  parcelId              String?
  productName           String
  quantity              Float
  unit                  String
  unitPrice             Float
  status                InventoryStatus @default(AVAILABLE)
  estimatedDeliveryDays Int?
  availableCities       String[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  expiresAt             DateTime?
  batches               batches[]
  estates               estates         @relation(fields: [estateId], references: [id])
  hubs                  hubs            @relation(fields: [hubId], references: [id])
  parcels               parcels?        @relation(fields: [parcelId], references: [id])
  order_items           order_items[]

  @@index([availableCities])
  @@index([estateId])
  @@index([hubId])
  @@index([status])
}

model invoices {
  id            String      @id
  invoiceNumber String      @unique
  orderId       String      @unique
  deliveryId    String?     @unique
  pdfUrl        String
  pdfHash       String
  invoiceData   Json
  sentToEmail   String?
  sentAt        DateTime?
  generatedAt   DateTime    @default(now())
  deliveries    deliveries? @relation(fields: [deliveryId], references: [id])
  orders        orders      @relation(fields: [orderId], references: [id])

  @@index([invoiceNumber])
  @@index([orderId])
}

model location_logs {
  id               String    @id
  missionId        String?
  vehicleId        String?
  batchId          String?
  latitude         Float
  longitude        Float
  accuracy         Float?
  address          String?
  reportedByUserId String
  deviceId         String?
  timestamp        DateTime  @default(now())
  missions         missions? @relation(fields: [missionId], references: [id])
  users            users     @relation(fields: [reportedByUserId], references: [id])

  @@index([batchId])
  @@index([missionId])
  @@index([timestamp])
  @@index([vehicleId])
}

model logistics_handovers {
  id                       String                  @id
  missionId                String                  @unique
  insideTruckTemperature   Float
  /// Loading documentation: at least one per category required before READY_FOR_LOADING
  palletPhotos             Json?
  truckInteriorPhotos      Json?
  verifiedBy               String
  notes                    String?
  timestamp                DateTime                @default(now())
  status                   HandoverStatus @default(PENDING)
  /// Field pickup: delegated driver (from logistics_drivers) + immutable snapshot
  pickupDriverId               String?
  pickupDriverSnapshot         Json?
  pickupBadgePhotoUrl          String?                 @db.Text
  pickupDriverSignatureUrl     String?                 @db.Text
  /// Receiver (at farm / warehouse) — name + optional canvas/signature image (data URL)
  receiverName             String?
  receiverSignatureDataUrl String?                 @db.Text
  receiverSignedAt         DateTime?
  receiverProofPdfHash     String?
  missions                 missions                @relation(fields: [missionId], references: [id])
  pickup_driver            logistics_drivers?      @relation("HandoverPickupDriver", fields: [pickupDriverId], references: [id], onDelete: SetNull)

  @@index([missionId])
  @@index([status])
  @@index([verifiedBy])
  @@index([pickupDriverId])
}

/// Pallet/box QR hierarchy: parent serial + children; public scan resolves to farmer profile + optional batch.
model package_badges {
  id              String                @id @default(uuid())
  serial          String                @unique
  parentId        String?
  type            PackageBadgeType
  ownerUserId     String?
  createdByUserId String
  batchId         String?
  /// e.g. FARMER-FARMER001 — copied for fast public resolve on any child
  farmerQrCode    String?
  lifecycle       PackageBadgeLifecycle @default(ACTIVE)
  /// Optional link to a print-order row that proposed these serials for the factory
  printOrderId    String?
  createdAt       DateTime              @default(now())
  parent          package_badges?       @relation("BadgeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        package_badges[]      @relation("BadgeTree")
  owner           users?                @relation("PackageBadgeOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy       users                 @relation("PackageBadgeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  batch           batches?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  printOrder      badge_print_orders?   @relation(fields: [printOrderId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([ownerUserId])
  @@index([farmerQrCode])
  @@index([batchId])
  @@index([createdAt])
  @@index([printOrderId])
  @@index([lifecycle])
}

/// Porudžbenica/payload za štampu kod eksterne fabrike: plan glavnih (palet/rolo) + podređenih serija, bez obaveze da su već u bazi
model badge_print_orders {
  id                String                @id @default(uuid())
  requesterUserId   String
  /// MATERIAL_SUPPLIER (štamparija) — opciono za adresiranje i prosleđivanje
  printerSupplierId String?
  parentCount       Int
  childrenPerParent Int
  serialPrefix      String                @default("PLT")
  /// Snapshot: orderRef, parents[], children: Record<parent, child[]>
  planJson          Json
  notesToPrinter    String?               @db.Text
  status            BadgePrintOrderStatus @default(DRAFT)
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  requester         users                 @relation("BadgePrintOrderRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  printerSupplier   users?                @relation("BadgePrintOrderPrinter", fields: [printerSupplierId], references: [id], onDelete: SetNull)
  package_badges    package_badges[]

  @@index([requesterUserId, createdAt])
  @@index([printerSupplierId])
  @@index([status])
}

model market_prices {
  id            String         @id
  cropType      String
  buyPrice      Float
  sellPrice     Float
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  setByUserId   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  users         users?         @relation(fields: [setByUserId], references: [id])
  transactions  transactions[]

  @@index([cropType])
  @@index([effectiveFrom])
  @@index([isActive])
}

model material_inventory {
  id             String         @id
  materialTypeId String
  serialNumber   String?        @unique
  batchNumber    String?
  status         MaterialStatus @default(AVAILABLE)
  soldToUserId   String?
  soldAt         DateTime?
  usedInBatchId  String?
  usedAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  material_types material_types @relation(fields: [materialTypeId], references: [id])
  users          users?         @relation(fields: [soldToUserId], references: [id])

  @@index([materialTypeId])
  @@index([serialNumber])
  @@index([soldToUserId])
  @@index([status])
}

model material_types {
  id                 String               @id
  name               String               @unique
  type               MaterialTypeEnum
  unit               String
  unitPrice          Float
  description        String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  material_inventory material_inventory[]

  @@index([isActive])
  @@index([type])
}

model missions {
  delivery                                 deliveries?
  id                                       String                 @id
  missionNumber                            String                 @unique
  growerId                                 String
  batchId                                  String?
  /// Set when this transport run was opened from a grower harvest plan (berba / isporuka)
  harvestAnnouncementId                    String?                @unique
  pickupLocation                           Json
  pickupAddress                            String
  /// Full delivery / drop-off address (buyer, hub, DC — as agreed for this run)
  destinationAddress                       String?
  /// e.g. "Hamburg" — for dispatch to group loads on the same trip
  destinationCity                          String?
  /// Pallets, time windows, dock — operativa + grower
  loadInstructions                         String?
  logisticsPartnerId                       String?
  /// Delegated pickup driver (person) under the logistics company — visible to grower
  assignedLogisticsDriverId                String?
  vehicleId                                String?
  optimalRoute                             Json?
  estimatedPickupTime                      DateTime?
  status                                   MissionStatus          @default(PENDING)
  requestedAt                              DateTime               @default(now())
  assignedAt                               DateTime?
  acceptedAt                               DateTime?
  pickedUpAt                               DateTime?
  completedAt                              DateTime?
  createdAt                                DateTime               @default(now())
  updatedAt                                DateTime
  border_wait_times                        border_wait_times[]
  location_logs                            location_logs[]
  logistics_handovers                      logistics_handovers?
  batches                                  batches?               @relation(fields: [batchId], references: [id])
  harvest_announcement                     harvest_announcements? @relation(fields: [harvestAnnouncementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Buyer sales order this run fulfills (operativa links order → grower mission)
  orderId                                  String?
  orders                                   orders?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  users_missions_growerIdTousers           users                  @relation("missions_growerIdTousers", fields: [growerId], references: [id])
  users_missions_logisticsPartnerIdTousers users?                 @relation("missions_logisticsPartnerIdTousers", fields: [logisticsPartnerId], references: [id])
  assigned_logistics_driver                logistics_drivers?     @relation("MissionAssignedLogisticsDriver", fields: [assignedLogisticsDriverId], references: [id], onDelete: SetNull)
  vehicles                                 vehicles?              @relation(fields: [vehicleId], references: [id])
  temperature_logs                         temperature_logs[]

  @@index([growerId])
  @@index([logisticsPartnerId])
  @@index([assignedLogisticsDriverId])
  @@index([missionNumber])
  @@index([status])
  @@index([harvestAnnouncementId])
  @@index([destinationCity])
  @@index([orderId])
}

model notification_templates {
