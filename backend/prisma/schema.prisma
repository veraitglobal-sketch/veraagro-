  @@unique([buyerId, clientRequestId])
  sourceCatalogId String?
  stockReservation order_stock_reservations?
  id                   String                 @id
  orderNumber          String                 @unique
  buyerId              String
  estateId             String
  /// Physical farm that will supply the order; set by operativa. `estateId` is the line seller (Vera platform estate).
  fulfillingEstateId   String?
  parcelId             String?
  productName          String
  quantity             Float
  unit                 String
  unitPrice            Float
  totalAmount          Float
  deliveryAddress      Json
  deliveryNotes        String?
  rejectionReason      String?
  catalogProductId     String?
  packOptionId         String?
  packLabel            String?
  packSizeKg           Float?
  packCount            Int?
  packedPackCount      Int?
  packedKg             Float?
  packedAt             DateTime?
