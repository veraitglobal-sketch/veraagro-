model ai_conversations {
  id               String   @id @default(uuid())
  sessionId        String
  messages         Json // Array of {role: 'user'|'assistant', content: string, timestamp: DateTime}
  userInfo         Json? // {ipAddress, userAgent, language}
  contactRequested Boolean  @default(false)
  contactInfo      Json? // {name, email, phone, message, consentGiven: boolean}
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sessionId])
  @@index([contactRequested])
  @@index([createdAt])
  @@map("ai_conversations")
}

/// Inbox for grower app offline queue: product entries, cost lines, certificate metadata (image URI may be device-local only until upload flow exists)
model grower_mobile_ingest {
  id              String   @id @default(uuid())
  userId          String
  /// PRODUCT | COST | CERT_PHOTO
  kind            String
  /// Stable id from the device (e.g. pending_* id) for idempotent sync
  clientReference String
  payload         Json
  createdAt       DateTime @default(now())
  users           users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, clientReference])
  @@index([userId])
  @@index([createdAt])
}

/// Full-shipment return; pickup and receipt have distinct actors and evidence.
model delivery_returns {
  stockStatus String @default("QUARANTINED")
  stockRevision Int @default(0)
  dispositions return_dispositions[]
  id String @id @default(uuid())
  deliveryId String @unique
  issueId String? @unique
  disputeId String? @unique
  status String @default("PLANNED")
  carrierUserId String
  receiverUserId String
  destinationAddress String
  instructions String
  createdBy String
  collectedBy String?
  receivedBy String?
  collectedAt DateTime?
  receivedAt DateTime?
  collectionPhotos String[] @default([])
  receiptPhotos String[] @default([])
  collectionNotes String?
  receiptNotes String?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  delivery deliveries @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  issue buyer_delivery_issues? @relation(fields: [issueId], references: [id], onDelete: Restrict)
  dispute disputes? @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  refund delivery_refunds?
  @@index([carrierUserId, status])
  @@index([receiverUserId, status])
}

/// Records an authorized external bank refund; does not send money or reverse recipient wallets.
model delivery_refunds {
  reconciliation refund_reconciliations?
  id String @id @default(uuid())
  deliveryId String @unique
  paymentId String @unique
  returnId String @unique
  status String @default("APPROVED")
  amountCents Int
  currency String
  originalPaymentStatus String
  reconciliationRequired Boolean @default(false)
  approvedBy String
  approvedAt DateTime @default(now())
  confirmedBy String?
  confirmedAt DateTime?
  bankReference String? @unique
  bankPaidAt DateTime?
  bankEvidence String?
  reason String
  revision Int @default(0)
  delivery deliveries @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  payment payments @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnCase delivery_returns @relation(fields: [returnId], references: [id], onDelete: Restrict)
  @@index([status])
}

/// An explicit, immutable decision after the buyer's bank refund has been recorded.
model refund_reconciliations {
  id String @id @default(uuid())
  refundId String @unique
  amountCents Int
  currency String
  recoveredCents Int
  platformCostCents Int
  reason String
  createdBy String
  createdAt DateTime @default(now())
  requestHash String
  refund delivery_refunds @relation(fields: [refundId], references: [id], onDelete: Restrict)
  entries refund_reconciliation_entries[]
}

model refund_reconciliation_entries {
  id String @id @default(uuid())
  reconciliationId String
  sourceKey String
  creditId String? @unique
  debitId String? @unique
  recipientUserId String?
  amountCents Int
  method String
  reconciliation refund_reconciliations @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  credit wallet_transactions? @relation("RefundRecoverySource", fields: [creditId], references: [id], onDelete: Restrict)
  debit wallet_transactions? @relation("RefundRecoveryDebit", fields: [debitId], references: [id], onDelete: Restrict)
  @@unique([reconciliationId, sourceKey])
  @@index([recipientUserId])
}

/// Inspection decisions; RESTOCK sets a verified physical count, never blind +return quantity.
model return_dispositions {
  id String @id @default(uuid())
  returnId String
  revision Int
  action String
  quantity Float
  unit String
  notes String
  photos String[] @default([])
  createdBy String
  createdAt DateTime @default(now())
  requestHash String
  inventoryId String?
  previousQuantity Float?
  countedQuantity Float?
  previousInventoryStatus String?
  previousExpiresAt DateTime?
  restockExpiresAt DateTime?
  returnCase delivery_returns @relation(fields: [returnId], references: [id], onDelete: Restrict)
  inventory inventory? @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  @@unique([returnId, revision])
  @@index([inventoryId])
}

/// inventory.quantity is free stock: reserve subtracts once, issue does not subtract again.
model order_stock_reservations {
  id String @id @default(uuid())
  orderId String @unique
  inventoryId String
  quantity Float
  unit String
  status String @default("RESERVED")
  reservedBy String
  reservedAt DateTime @default(now())
  issuedAt DateTime?
  releasedAt DateTime?
  order orders @relation(fields: [orderId], references: [id], onDelete: Restrict)
  inventory inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  @@index([inventoryId, status])
}

/// Season pre-order (planning quantities, not a binding order) submitted by a buyer.
model pre_orders {
  id                 String    @id @default(uuid())
  season             Int
  buyerId            String?
  companyName        String
  contactPerson      String
  email              String
  phone              String?
  /// [{ productId, varietyId?, label, quantityKg }]
  lines              Json
  totalKg            Float
  deliveryFrom       String?
  deliveryTo         String?
  quality            String?
  packaging          String?
  notes              String?
  /// NEW | REVIEWED | CONFIRMED | DECLINED
  status             String    @default("NEW")
  adminNote          String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  users              users?    @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([season, status])
  @@index([buyerId])
  @@index([createdAt])
}
