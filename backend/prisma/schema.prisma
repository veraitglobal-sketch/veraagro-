model wallet_transactions {
  refundRecoverySource refund_reconciliation_entries? @relation("RefundRecoverySource")
  refundRecoveryDebit refund_reconciliation_entries? @relation("RefundRecoveryDebit")
  id          String                  @id
  walletId    String
  type        WalletTransactionType
  amount      Float
  status      WalletTransactionStatus @default(PENDING)
  orderId     String?
  deliveryId  String?
  description String
  createdAt   DateTime                @default(now())
  completedAt DateTime?
  wallets     wallets                 @relation(fields: [walletId], references: [id])

  @@index([status])
  @@index([type])
  @@index([walletId])
}

model wallets {
  id                  String                @id
  userId              String                @unique
  availableBalance    Float                 @default(0.0)
  pendingBalance      Float                 @default(0.0)
  totalEarned         Float                 @default(0.0)
  bankAccount         Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  wallet_transactions wallet_transactions[]
  users               users                 @relation(fields: [userId], references: [id])

  @@index([userId])
}

model waybills {
  id            String     @id
  waybillNumber String     @unique
  deliveryId    String     @unique
  pdfUrl        String
  pdfHash       String
  generatedData Json
  generatedAt   DateTime   @default(now())
  deliveries    deliveries @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId])
  @@index([waybillNumber])
}

model digital_handovers {
  revision          Int @default(0)
  id            String                @id @default(uuid())
  deliveryId    String                @unique
  driverId      String
  storeQrCode   String
  status        DigitalHandoverStatus @default(INITIATED)
  qualityStatus QualityStatus?
  temperature   Float?
  photoUrls     String[]
  signature     String?
  notes         String?
  completedBy   String?
  completedAt   DateTime?
  initiatedAt   DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deliveries    deliveries            @relation("DigitalHandovers", fields: [deliveryId], references: [id])
  users         users                 @relation("DriverHandovers", fields: [driverId], references: [id])
  disputes      disputes[]

  @@index([deliveryId])
  @@index([driverId])
  @@index([status])
  @@index([initiatedAt])
  @@map("digital_handovers")
}

model disputes {
  returnCase        delivery_returns?
  outcome           String?
  revision          Int @default(0)
  id                String            @id @default(uuid())
  handoverId        String
  reason            String
  status            String            @default("PENDING")
  evidencePhotos    String[]
  resolvedBy        String?
  resolvedAt        DateTime?
  resolution        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  digital_handovers digital_handovers @relation(fields: [handoverId], references: [id])

  @@index([handoverId])
  @@index([status])
  @@index([createdAt])
  @@map("disputes")
}

model plot_blueprints {
  id            String   @id @default(uuid())
  parcelId      String   @unique
  blueprintData Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  parcels       parcels  @relation(fields: [parcelId], references: [id])

  @@index([parcelId])
  @@map("plot_blueprints")
}

