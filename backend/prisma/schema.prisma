/// Bio Vera field / commercial office — used to match growers & partners to nearby agents (admin assigns manually)
model commercial_agent_profiles {
  id         String   @id @default(uuid())
  userId     String   @unique
  officeName String?
  address    String
  postalCode String?
  city       String
  country    String
  /// { "lat": number, "lng": number } — optional; can be geocoded from address later
  location   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, country])
}

/// Distributor & supplier-partner interest from website (/suppliers) — internal pipeline; admin creates store account when ready.
model partner_applications {
  id             String                   @id @default(uuid())
  referenceCode  String                   @unique
  companyName    String
  pib            String?
  contactPerson  String
  email          String
  phone          String?
  website        String?
  productType    String?
  certifications Json?
  description    String?                  @db.Text
  status         PartnerApplicationStatus @default(SUBMITTED)
  internalNotes  String?                  @db.Text
  meetingAt      DateTime?
  linkedUserId   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  linkedUser     users?                   @relation("PartnerApplicationLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([referenceCode])
}

/// Snabdevač inputa (semena, đubriva, ambalaža) – lokacija na mapi nakon admin odobravanja
model material_supplier_profiles {
  id               String    @id @default(uuid())
  userId           String    @unique
  businessName     String
  description      String?
  /// Public website (https)
  website          String?   @db.Text
  /// Street line; combined with houseNumber for display + geocoding
  street           String?
  houseNumber      String?
  /// Street + number (e.g. "Bulevar kralja Aleksandra 15")
  address          String
  postalCode       String?
  city             String
  country          String
  /// { "lat": number, "lng": number }
  location         Json
  mapApproved      Boolean   @default(false)
  approvedAt       DateTime?
  approvedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             users     @relation("MaterialSupplierUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([mapApproved, country])
  @@index([city])
}

/// Partner store sell list (seeds, inputs, packaging) — created by the supplier; reference for grower direct orders
model supplier_catalog_items {
  id                String                       @id @default(uuid())
  supplierUserId    String
  approvedProductId String?
  name              String
  description       String?                      @db.Text
  unit              String                       @default("unit")
  listPrice         Float?
  sku               String?
  /// https URL (Vercel Blob) or data URL for product photo (seeds, packaging)
  imageUrl          String?                      @db.Text
  isActive          Boolean                      @default(true)
  sortOrder         Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  supplier          users                        @relation("SupplierCatalogItems", fields: [supplierUserId], references: [id], onDelete: Cascade)
  approvedProduct   approved_products?           @relation(fields: [approvedProductId], references: [id], onDelete: SetNull)
  material_barcodes supplier_material_barcodes[]

  @@index([supplierUserId, isActive])
  @@index([supplierUserId, sortOrder])
  @@index([approvedProductId])
}

model supplier_threads {
  id             String                     @id @default(uuid())
  farmerId       String
  supplierUserId String
  lastMessageAt  DateTime                   @default(now())
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  farmer         users                      @relation("SupplierThreadFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  supplier       users                      @relation("SupplierThreadSupplier", fields: [supplierUserId], references: [id], onDelete: Cascade)
  messages       supplier_thread_messages[]
  direct_orders  supplier_direct_orders[]

  @@unique([farmerId, supplierUserId])
  @@index([supplierUserId])
  @@index([farmerId])
}

model supplier_thread_messages {
  id        String           @id @default(uuid())
  threadId  String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  thread    supplier_threads @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    users            @relation("SupplierMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model supplier_direct_orders {
  id                String                       @id @default(uuid())
  threadId          String?
  farmerId          String
  supplierUserId    String
  status            SupplierDirectOrderStatus    @default(PENDING)
  /// [{ "label": "...", "quantity": 1, "unit": "bag" }]
  items             Json
  noteFromFarmer    String?
  noteFromSupplier  String?
  /// Grower marked goods received at the farm (independent of supplier workflow status)
  farmerReceivedAt  DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  thread            supplier_threads?            @relation(fields: [threadId], references: [id], onDelete: SetNull)
  farmer            users                        @relation("SupplierOrderFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  supplier          users                        @relation("SupplierOrderSupplier", fields: [supplierUserId], references: [id], onDelete: Cascade)
  material_barcodes supplier_material_barcodes[]

  @@index([farmerId, createdAt])
  @@index([supplierUserId, status])
}

/// Physical unit instance: supplier registers barcode on goods-in; marks SOLD when selling to a grower (optional link to order).
model supplier_material_barcodes {
  id             String                        @id @default(uuid())
  supplierUserId String
  catalogItemId  String?
  /// Raw scanned value (EAN-13, Code128, etc.) — unique system-wide for this unit line
  barcode        String                        @unique
  status         SupplierMaterialBarcodeStatus @default(IN_STOCK)
  lotNumber      String?
  note           String?                       @db.Text
  receivedAt     DateTime                      @default(now())
  soldAt         DateTime?
  soldToFarmerId String?
  directOrderId  String?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  supplier       users                         @relation("SupplierMaterialBarcodes", fields: [supplierUserId], references: [id], onDelete: Cascade)
  catalogItem    supplier_catalog_items?       @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  soldToFarmer   users?                        @relation("SupplierBarcodeSoldToFarmer", fields: [soldToFarmerId], references: [id], onDelete: SetNull)
  directOrder    supplier_direct_orders?       @relation(fields: [directOrderId], references: [id], onDelete: SetNull)

  @@index([supplierUserId, status])
  @@index([supplierUserId, createdAt])
}

model email_verification_tokens {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model password_reset_tokens {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

/// Person (driver / responsible rep) under a logistics partner — not a full platform user; grower sees profile on pickup.
model logistics_drivers {
  id                 String   @id @default(uuid())
  logisticsPartnerId String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  photoUrl           String?  @db.Text
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              users    @relation(fields: [logisticsPartnerId], references: [id], onDelete: Cascade)
  missions_assigned  missions[]              @relation("MissionAssignedLogisticsDriver")
  handovers_as_pickup logistics_handovers[]    @relation("HandoverPickupDriver")

  @@index([logisticsPartnerId])
  @@index([isActive])
}

model vehicles {
  id                 String             @id
  vehicleNumber      String             @unique
  logisticsPartnerId String
  type               String
  make               String?
  model              String?
  licensePlate       String             @unique
  hasFrigo           Boolean            @default(true)
  tempRangeMin       Float
  tempRangeMax       Float
  status             VehicleStatus      @default(AVAILABLE)
  currentLocation    Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  missions           missions[]
  temperature_logs   temperature_logs[]
  users              users              @relation(fields: [logisticsPartnerId], references: [id])

