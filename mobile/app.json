{
  "expo": {
    "name": "Bio Vera",
    "slug": "biovera",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "biovera",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#f6f5f1",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biovera.app",
      "associatedDomains": [
        "applinks:biovera.app",
        "applinks:www.biovera.app"
      ],
      "splash": {
        "backgroundColor": "#f6f5f1"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Bio Vera needs camera access to capture growth evidence with GPS metadata.",
        "NSLocationWhenInUseUsageDescription": "Bio Vera needs location access to verify parcel boundaries and prevent fraud.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Bio Vera needs location access to verify parcel boundaries and prevent fraud.",
        "NSUserNotificationsUsageDescription": "Obaveštenja o žetvi, transportu, sinhronizaciji terenskih unosa i porukama Bio Vera tima.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "splash": {
        "backgroundColor": "#f6f5f1"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D5A27"
      },
      "package": "com.biovera.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "biovera.app",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "www.biovera.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bio Vera to access your camera to capture growth evidence."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bio Vera koristi fotografije samo kao dokaz unosa na parceli.",
          "cameraPermission": "Bio Vera treba kameru za fotografiju terenskog unosa (dnevnik) uz GPS dokaz."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bio Vera to access your location to verify parcel boundaries."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "def74f3e-3abe-4b23-b0c6-044801a02e08"
      }
    }
  }
}
