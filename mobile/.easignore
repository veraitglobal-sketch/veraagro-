# EAS upload ignore — patterns must be relative (no ".." segments).
# @see https://docs.expo.dev/build-reference/easignore/

node_modules/
.expo/
dist/
ios/
android/
.DS_Store
*.log
.env
.env.*

# Monorepo siblings (repo-root folder names when EAS uploads the git tree)
backend/
web/
blockchain/
filedump/
