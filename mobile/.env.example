# =============================================================================
# Jedan Nest API za mobilnu i web aplikaciju (isti URL kao NEXT_PUBLIC_API_URL na webu).
# =============================================================================
# Produkcija / Railway (isti URL kao NEXT_PUBLIC_API_URL na Vercelu):
EXPO_PUBLIC_API_URL=https://biovera-production.up.railway.app
# Custom domain (samo ako api.biovera.app zaista pokazuje na Railway i /health radi):
# EXPO_PUBLIC_API_URL=https://api.biovera.app
# Lokalno (simulator + pokrenut `npm run start:dev` u backend/):
# EXPO_PUBLIC_API_URL=http://localhost:3000
# Fizički uređaj + lokalni Nest na Mac-u (LAN IP iz Expo terminala):
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000
# Ako backend radi na drugom portu:
# EXPO_PUBLIC_DEV_API_PORT=3004

# Javni URL sajta — isti kao NEXT_PUBLIC_BASE_URL na webu (QR, linkovi iz app-a).
EXPO_PUBLIC_SITE_URL=https://biovera.app

# Ista kao web — prikaz u aplikaciji za APPROVED porudžbine (bankovni prenos)
# EXPO_PUBLIC_BIOVERA_BENEFICIARY_NAME=
# EXPO_PUBLIC_BIOVERA_BANK_NAME=
# EXPO_PUBLIC_BIOVERA_BANK_IBAN=
# EXPO_PUBLIC_BIOVERA_SWIFT=
# EXPO_PUBLIC_BIOVERA_PAYMENT_CURRENCY=EUR
# EXPO_PUBLIC_BIOVERA_PAYMENT_NOTES=Linija1|Linija2
