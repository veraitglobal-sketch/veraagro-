# Backend API URL (Nest API), not the marketing site.
# Build bez ovoga: release/preview u mobile/lib/api-url.ts podrazumeva https://api.biovera.app
# Fizički uređaj u dev-u: stavi http://<LAN-IP>:<PORT> (isti kao u backend; simulator koristi EXPO_PUBLIC_DEV_API_PORT)
EXPO_PUBLIC_API_URL=https://api.biovera.app
# Lokalni backend (fizički telefon; PORT kao u terminalu backend-a):
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000
# Ako backend koristi 3004, i simulator bez punog EXPO_PUBLIC_API_URL:
# EXPO_PUBLIC_DEV_API_PORT=3004
#
# Ista kao web (Vercel) — prikaz u aplikaciji za APPROVED porudžbine (bankovni prenos)
# EXPO_PUBLIC_BIOVERA_BENEFICIARY_NAME=
# EXPO_PUBLIC_BIOVERA_BANK_NAME=
# EXPO_PUBLIC_BIOVERA_BANK_IBAN=
# EXPO_PUBLIC_BIOVERA_SWIFT=
# EXPO_PUBLIC_BIOVERA_PAYMENT_CURRENCY=EUR
# EXPO_PUBLIC_BIOVERA_PAYMENT_NOTES=Linija1|Linija2
