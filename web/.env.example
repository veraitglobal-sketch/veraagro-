# Bio Vera web (Next.js) — copy to `.env.local` for local dev. Never commit real secrets.
# Vercel (production): Project → Settings → Environment Variables.

# --- Required ---

# Backend API origin for all client and server-side fetch calls.
# Read in: web/lib/api-base.ts, web/lib/api.ts, web/lib/public-api.ts, web/app/api/**/route.ts
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Recommended for production ---

# Canonical site URL (metadata, sitemap, schema.org). Default: https://biovera.app
# Read in: web/lib/site-url.ts
NEXT_PUBLIC_SITE_URL=https://biovera.app

# Logout redirect target. Default in dev: http://localhost:3000
# Read in: web/app/api/logout/route.ts
NEXT_PUBLIC_BASE_URL=https://biovera.app

# --- Optional ---

# Google Maps embed on transparency batch page
# Read in: web/app/transparency/batch/[batchId]/page.tsx
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Contact form (Formspree). Read in: web/lib/api.ts
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# App store links in footer. Read in: web/components/Footer.tsx
# NEXT_PUBLIC_IOS_APP_STORE_URL=
# NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=

# Bank transfer instructions (buyer checkout). Read in: web/lib/biovera-payment-public.ts
# NEXT_PUBLIC_BIOVERA_BENEFICIARY_NAME=
# NEXT_PUBLIC_BIOVERA_BANK_IBAN=
# NEXT_PUBLIC_BIOVERA_BANK_NAME=
# NEXT_PUBLIC_BIOVERA_SWIFT=
# NEXT_PUBLIC_BIOVERA_PAYMENT_CURRENCY=EUR
# NEXT_PUBLIC_BIOVERA_PAYMENT_NOTES=

# Server-side aliases for bank requisites (runtime override if NEXT_PUBLIC_* missing at build)
# Read in: web/app/api/biovera-bank-requisites/route.ts
# BIOVERA_BENEFICIARY_NAME=
# BIOVERA_BANK_IBAN=
# BIOVERA_BANK_NAME=
# BIOVERA_SWIFT=
# BIOVERA_PAYMENT_CURRENCY=EUR
# BIOVERA_PAYMENT_NOTES=

# Grower confidential / partner plan gate (server-only, not NEXT_PUBLIC)
# GROWER_CONFIDENTIAL_SECTION_ENABLED=false
# GROWER_CONFIDENTIAL_ACCESS_TOKEN=
# GROWER_CONFIDENTIAL_SESSION_SECRET=

# Investor / pitch deck
# NEXT_PUBLIC_PITCH_DECK_VIDEO_URL=
# NEXT_PUBLIC_PROJECT_OVERVIEW_FOUNDER_SRC=
