# =============================================================================
# Jedan Nest API za web i mobilnu aplikaciju (isti URL u svakom okruženju).
# Web:  NEXT_PUBLIC_API_URL
# App:  EXPO_PUBLIC_API_URL  — ista vrednost kao ispod (plus mobile/.env.example)
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.biovera.app
# Lokalno (podrazumevani Nest port 3000 — vidi backend/src/main.ts):
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Javni URL fronta (marketing / redirect). Isto kao EXPO_PUBLIC_SITE_URL na mobilnom.
NEXT_PUBLIC_BASE_URL=https://biovera.app
# Lokalno Next:
# NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Kada su aplikacije u store-ovima, postavite pun URL listinga (footer bedževi postaju linkovi).
# NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id000000000
# Pitch deck — embed YouTube or Vimeo (watch, youtu.be, shorts, vimeo.com/...).
# Embed URL for optional video on `/[locale]/investor-deck` (still named pitch in env)
# NEXT_PUBLIC_PITCH_DECK_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
#
# Default banner: `project-overview-founder.jpg` in `web/public/` (omit env to use it). Prefer ≥2400px width for retina + PDF.
# NEXT_PUBLIC_PROJECT_OVERVIEW_FOUNDER_SRC=/your-banner-2400w.jpg

# Shown in buyer portal when an order is APPROVED (bank transfer). Use your legal company name.
# NEXT_PUBLIC_* is inlined at `next build` — for Vercel, also set the BIOVERA_* copies below
# (read at request time) so requisites work without a rebuild.
NEXT_PUBLIC_BIOVERA_BENEFICIARY_NAME=Bio Vera
NEXT_PUBLIC_BIOVERA_BANK_NAME=
NEXT_PUBLIC_BIOVERA_BANK_IBAN=
NEXT_PUBLIC_BIOVERA_SWIFT=
NEXT_PUBLIC_BIOVERA_PAYMENT_CURRENCY=EUR
# Optional, extra lines separated by |
# NEXT_PUBLIC_BIOVERA_PAYMENT_NOTES=Use reference below|SEPA only
#
# Server-only aliases (same values OK) — /api/biovera-bank-requisites uses these at runtime
# BIOVERA_BENEFICIARY_NAME=
# BIOVERA_BANK_NAME=
# BIOVERA_BANK_IBAN=
# BIOVERA_SWIFT=
# BIOVERA_PAYMENT_CURRENCY=EUR
# BIOVERA_PAYMENT_NOTES=
