# =============================================================================
# Jedan Nest API za web i mobilnu aplikaciju (isti URL u svakom okruženju).
# Web:  NEXT_PUBLIC_API_URL
# App:  EXPO_PUBLIC_API_URL  — ista vrednost kao ispod (plus mobile/.env.example)
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.biovera.app
# Lokalno (podrazumevani Nest port 3000 — vidi backend/src/main.ts):
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Javni URL fronta (marketing / redirect). Isto kao EXPO_PUBLIC_SITE_URL na mobilnom.
NEXT_PUBLIC_BASE_URL=https://biovera.app
# Lokalno Next:
# NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Kada su aplikacije u store-ovima, postavite pun URL listinga (footer bedževi postaju linkovi).
# NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/app/id000000000
# Pitch deck video — embed YouTube or Vimeo (watch, youtu.be, shorts, vimeo.com/...).
# Shown on `/[locale]/investor-deck/slides` (optional).
# NEXT_PUBLIC_PITCH_DECK_VIDEO_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
#
# Default banner: `project-overview-founder.jpg` in `web/public/` (omit env to use it). Prefer ≥2400px width for retina + PDF.
# NEXT_PUBLIC_PROJECT_OVERVIEW_FOUNDER_SRC=/your-banner-2400w.jpg

# Shown in buyer portal when an order is APPROVED (bank transfer). Use your legal company name.
# NEXT_PUBLIC_* is inlined at `next build` — for Vercel, also set the BIOVERA_* copies below
# (read at request time) so requisites work without a rebuild.
NEXT_PUBLIC_BIOVERA_BENEFICIARY_NAME=Bio Vera
NEXT_PUBLIC_BIOVERA_BANK_NAME=
NEXT_PUBLIC_BIOVERA_BANK_IBAN=
NEXT_PUBLIC_BIOVERA_SWIFT=
NEXT_PUBLIC_BIOVERA_PAYMENT_CURRENCY=EUR
# Optional, extra lines separated by |
# NEXT_PUBLIC_BIOVERA_PAYMENT_NOTES=Use reference below|SEPA only
#
# Server-only aliases (same values OK) — /api/biovera-bank-requisites uses these at runtime
# BIOVERA_BENEFICIARY_NAME=
# BIOVERA_BANK_NAME=
# BIOVERA_BANK_IBAN=
# BIOVERA_SWIFT=
# BIOVERA_PAYMENT_CURRENCY=EUR
# BIOVERA_PAYMENT_NOTES=

# -----------------------------------------------------------------------------
# Grower confidential partner plans (/grower/confidential + /grower/confidential/plan/*)
# Server-only — set in Vercel/host env (no NEXT_PUBLIC_*). JWT must be valid grower.
#
# Reading view: Markdown files `web/content/partner-plans/{short,medium,long}.md` (committed in repo).
# Production: set GROWER_CONFIDENTIAL_SESSION_SECRET so HttpOnly unlock cookies work for internal reader.
# -----------------------------------------------------------------------------
# GROWER_CONFIDENTIAL_SECTION_ENABLED=true
# GROWER_CONFIDENTIAL_SESSION_SECRET=generate-a-long-random-string
# Medium-term plan: minimum full calendar years since grower account registration (default 3). Use 0 to disable this gate (dev).
# GROWER_CONFIDENTIAL_MEDIUM_MIN_YEARS=3
# Long-term plan: minimum years (default = medium + 3, i.e. 6 when medium is 3). Use 0 to disable this gate (dev).
# GROWER_CONFIDENTIAL_LONG_MIN_YEARS=6
# Legacy single threshold for BOTH tiers if you do not set the two keys above:
# GROWER_CONFIDENTIAL_MEDIUM_LONG_MIN_YEARS=3
# Optional extra gate: invite link ?access=TOKEN matching header X-Grower-Confidential-Access
# GROWER_CONFIDENTIAL_ACCESS_TOKEN=
#
# Each tier needs a PASSWORD. Publish either an in-repo Markdown file (see paths above), or HTTPS URL, or both.
# Omit *_URL if you only use the on-site reading view.
# GROWER_CONFIDENTIAL_BUSINESS_PLAN_SHORT_URL=https://...
# GROWER_CONFIDENTIAL_BUSINESS_PLAN_SHORT_PASSWORD=your-secret
# GROWER_CONFIDENTIAL_BUSINESS_PLAN_MEDIUM_URL=https://...
# GROWER_CONFIDENTIAL_BUSINESS_PLAN_MEDIUM_PASSWORD=your-secret
# GROWER_CONFIDENTIAL_BUSINESS_PLAN_LONG_URL=https://...
# GROWER_CONFIDENTIAL_BUSINESS_PLAN_LONG_PASSWORD=your-secret
#
# NOT linked from marketing hubs — share the URL only with cleared recipients (NDA / committee).
# INVESTOR_BUSINESS_PLANS_ENABLED=true
# First password (opens all three document cards; each doc still needs its own tier password below)
# INVESTOR_BUSINESS_PLANS_GATE_PASSWORD=your-first-step-secret
# Unlock (same-origin): GET /[locale]/investor-deck/business-plans/unlock
# POST { "bundlePassword":"..." } | POST { "tier":"short"|"medium"|"long", "password":"..." } (tier only after bundle cookie)
# DELETE ?scope=bundle clears bundle + all tiers; DELETE ?tier=short|medium|long clears one tier
# Markdown: GET /[locale]/investor-deck/business-plans/plan-markdown/{short|medium|long} (needs bundle + tier cookies)
